{
  "name": "land-ledge",
  "version": "1.0.0",
  "description": "ArdhiChain - A decentralized land registry system built on Ethereum blockchain",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "update-frontend": "node scripts/update-frontend-address.js",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "setup": "npm install && cd client && npm install && cd ..",
    "dev:contracts": "hardhat node",
    "dev:frontend": "cd client && npm run dev",
    "deploy-and-update": "npm run deploy:local && npm run update-frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkoimett/land-ledge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/bkoimett/land-ledge/issues"
  },
  "homepage": "https://github.com/bkoimett/land-ledge#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.12",
    "@nomicfoundation/hardhat-ignition": "^3.1.6",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.6",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.6.0",
    "mocha": "^11.7.6",
    "typescript": "~6.0.3"
  }
}
